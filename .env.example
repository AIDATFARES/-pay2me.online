# ==================================================
# Pay2Me (www.pay2me.online) Environment Variables
# ==================================================

# 1. Google Sheets Integration (via Google Apps Script Web App)
# See google-apps-script.js for setup instructions
GOOGLE_SHEETS_WEBHOOK_URL="https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec"

# 2. CardToUSDT Payment Gateway (Direct Hosted Checkout)
# No API key required. Funds settle directly to your self-custodial EVM wallet.
CARDTOUSDT_PAYOUT_ADDRESS="0xYourPayoutWalletAddressHere"

# 3. Canonical Domain (for SEO sitemap & canonical links)
NEXT_PUBLIC_SITE_URL="https://www.pay2me.online"
